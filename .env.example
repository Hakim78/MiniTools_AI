# =============================================================================
# AI DAILY HUB - CONFIGURATION ENVIRONNEMENT
# =============================================================================
# Copier ce fichier en .env.local et remplir les valeurs
# Important: Ne jamais commit .env.local dans git !
# =============================================================================

# -----------------------------------------------------------------------------
# OPENAI (REQUIS pour les outils texte)
# -----------------------------------------------------------------------------
# Site: https://platform.openai.com/api-keys
# Usage: Tous les outils texte + SEO
OPENAI_API_KEY=sk-proj-...

# Model Configuration (Cost-Aware Routing)
# PRIMARY_MODEL: Flagship model for premium tasks (SEO generation, long content)
# - Default: gpt-4o (current flagship)
# - Future: gpt-4.1, gpt-5 when available
# - Use for: seo_generate, seo_rewrite
PRIMARY_MODEL=gpt-4o

# SECONDARY_MODEL: Cheaper model for daily tasks
# - Default: gpt-4o-mini (economic)
# - Use for: rewrite, correct, summarize, reply, prompt optimization
SECONDARY_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# GOOGLE GEMINI (Optionnel - pour le multi-LLM "comité")
# -----------------------------------------------------------------------------
# Site: https://ai.google.dev/
# Installation: npm install @google/generative-ai
# Usage: AI Router (comité multi-modèles)
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# DEEPSEEK (Optionnel - pour le multi-LLM "comité")
# -----------------------------------------------------------------------------
# Site: https://platform.deepseek.com/
# Note: API compatible OpenAI
# Usage: AI Router (comité multi-modèles)
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# GROK / X.AI (Optionnel - pour le multi-LLM "comité")
# -----------------------------------------------------------------------------
# Site: https://x.ai/
# Note: API compatible OpenAI
# Usage: AI Router (comité multi-modèles)
GROK_API_KEY=

# -----------------------------------------------------------------------------
# HUGGING FACE (Optionnel - pour les modèles open-source)
# -----------------------------------------------------------------------------
# Site: https://huggingface.co/settings/tokens
# Installation: npm install @huggingface/inference
# Usage: AI Router + Background Removal + Watermark Removal
HUGGINGFACE_API_KEY=

# -----------------------------------------------------------------------------
# REMOVE.BG (Optionnel - pour Background Removal commercial)
# -----------------------------------------------------------------------------
# Site: https://www.remove.bg/api
# Installation: npm install remove.bg
# Prix: 5 images gratuites/mois, puis 0.20€/image
# Usage: Background Removal (meilleure qualité que les modèles gratuits)
REMOVE_BG_API_KEY=

# -----------------------------------------------------------------------------
# REPLICATE (Optionnel - pour les modèles IA via API simple)
# -----------------------------------------------------------------------------
# Site: https://replicate.com/account/api-tokens
# Installation: npm install replicate
# Usage: Background Removal + Watermark Removal (inpainting)
REPLICATE_API_TOKEN=

# -----------------------------------------------------------------------------
# STRIPE (Paiements)
# -----------------------------------------------------------------------------
# Site: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Prix IDs Stripe (à créer dans votre dashboard Stripe)
STRIPE_STARTER_PRICE_ID=price_...  # 9.99€/mois
STRIPE_PRO_PRICE_ID=price_...      # 19.99€/mois

# -----------------------------------------------------------------------------
# CLERK (Authentification)
# -----------------------------------------------------------------------------
# Site: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# URLs Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# APP CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# NOTES D'IMPLÉMENTATION
# -----------------------------------------------------------------------------
#
# PRIORITÉ 1 (REQUIS) :
# - OPENAI_API_KEY : Nécessaire pour les outils texte et le prompt optimizer
#
# PRIORITÉ 2 (RECOMMANDÉ) :
# - CLERK_* : Pour l'authentification des utilisateurs
# - STRIPE_* : Pour les abonnements et paiements
#
# PRIORITÉ 3 (OPTIONNEL - Améliore la qualité) :
# - GEMINI_API_KEY, DEEPSEEK_API_KEY, GROK_API_KEY : Pour le comité multi-IA
# - REMOVE_BG_API_KEY ou REPLICATE_API_TOKEN : Pour les outils image
# - HUGGINGFACE_API_KEY : Pour les modèles open-source gratuits
#
# =============================================================================
